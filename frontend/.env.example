# Local AWS Emulator: leave VITE_API_URL unset (defaults to /api) and set the API id;
# the Vite dev server proxies /api to the emulator.
#   EMULATOR_API_ID=$(terraform -chdir=../infra output -raw api_id)
EMULATOR_API_ID=
# EMULATOR_PORT=9297
# EMULATOR_STAGE=local

# Real AWS: the `api_url` Terraform output.
# VITE_API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/dev
